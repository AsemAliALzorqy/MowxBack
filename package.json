{
  "name": "mowxback",
  "version": "0.4.0",
  "private": true,
  "description": "MowxBack — local Windows daily factory ledger",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "test:money": "node database/tests/test_money.js",
    "test:sqlite": "python database/tests/test_database.py",
    "test:repository": "node --no-warnings database/tests/test_repository_node.js",
    "test:bridge": "node database/tests/test_bridge_contract.js",
    "test": "npm run test:money && npm run test:sqlite && npm run test:repository && npm run test:bridge && npm run test:reports && npm run test:diagnostics && npm run test:dates && npm run test:telegram",
    "dist:win": "npm run rebuild:native && electron-builder --win nsis --x64",
    "test:reports": "node database/tests/test_report_template.js",
    "test:diagnostics": "node database/tests/test_diagnostic_logger.js",
    "test:dates": "node database/tests/test_report_dates.js",
    "test:telegram": "node database/tests/test_telegram.js"
  },
  "dependencies": {
    "better-sqlite3": "13.2.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "electron": "45.4.1",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "net.mowxback.desktop",
    "productName": "MowxBack",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "electron/**/*",
      "src/**/*",
      "reports/**/*",
      "database/schema.sql",
      "database/migrations/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MowxBack-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
